diff a/openwrt/cowboy-bebop-branding/Makefile b/openwrt/cowboy-bebop-branding/Makefile	(rejected hunks)
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=cowboy-bebop-branding
-PKG_RELEASE:=4
+PKG_RELEASE:=5
 PKG_LICENSE:=MIT
