{% 
	import { getuid, getspnam } from 'luci.core';
	const boardinfo = ubus.call('system', 'board') ?? {};
	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<title>{{ striptags((dispatched?.title ? _(dispatched.title) + ' | ' : '') + 'Cowboy Bebop Manager') }}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="darkreader-lock">
	<link rel="stylesheet" href="{{ media }}/cascade.css">
	<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/mobile.css">
	<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
	{% if (node?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">{% endif %}
	{% if (css): %}<style>{{ css }}</style>{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
</head>
<body class="{{ blank_page ? 'cb-auth' : ('lang_' + dispatcher.lang + ' ' + entityencode(striptags(node?.title ?? ''), true)) }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
{% if (!blank_page): %}
<aside class="cb-sidebar" id="cb-sidebar">
	<a class="cb-brand" href="{{ dispatcher.build_url('admin/services/cowboy-bebop/overview') }}">
		<img src="{{ media }}/logo.svg" alt="">
		<span>COWBOY BEBOP<small>NETWORK MANAGER</small></span>
	</a>
	<nav aria-label="Main navigation">
		<ul class="nav" id="topmenu"></ul>
	</nav>
	<div class="cb-sidebar-footer">
		<div class="cb-sidebar-status"><i></i><span>Management online</span></div>
		<div>Support: +20175555667</div>
		<div>+20 1009823007</div>
	</div>
</aside>
<header class="cb-topbar">
	<div class="cb-mobile-brand">
		<button type="button" class="cb-sidebar-toggle" aria-controls="cb-sidebar" aria-expanded="false" title="{{ _('Menu') }}">☰</button>
		<span>COWBOY BEBOP</span>
	</div>
	<div class="cb-page-title">{{ _(node?.title ?? 'Control Center') }}</div>
	<div class="cb-topbar-right">
		<div class="cb-online"><i></i><span>Online</span></div>
		<div class="cb-hostname">CONTROL NODE</div>
		<div id="indicators"></div>
	</div>
</header>
<main id="maincontent" class="container">
	{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
	<div class="alert-message warning"><strong>{{ _('Security notice') }}</strong><p>{{ _('A local administrator password is not configured.') }}</p></div>
	{% endif %}
	{% if (boardinfo.rootfs_type == 'initramfs'): %}
	<div class="alert-message warning"><strong>{{ _('Recovery mode') }}</strong><p>{{ _('Changes may not persist after reboot.') }}</p></div>
	{% endif %}
	<noscript><div class="alert-message warning"><strong>{{ _('JavaScript required') }}</strong><p>{{ _('Enable JavaScript to use the management interface.') }}</p></div></noscript>
	<div id="tabmenu"></div>
{% endif %}
