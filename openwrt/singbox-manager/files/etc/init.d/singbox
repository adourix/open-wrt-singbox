#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

NAME=singbox
PROG=/usr/bin/sing-box
CONFIG=/etc/singbox/config.json
BACKUP=/etc/singbox/config.json.bak
PENDING=/etc/singbox/config.pending
FIREWALL=/usr/lib/singbox-manager/network/firewall.sh

recover_pending_config() {
    [ -f "$PENDING" ] || return 0
    if [ -f "$BACKUP" ] && "$PROG" check -c "$BACKUP" >/dev/null 2>&1; then
        cp -f "$BACKUP" "$CONFIG" || return 1
        chmod 600 "$CONFIG" 2>/dev/null || true
        rm -f "$PENDING"
        logger -t singbox "pending configuration rolled back during boot"
        return 0
    fi
    rm -f "$PENDING"
    logger -t singbox "pending configuration could not be restored"
    return 1
}

start_service() {
    [ -x "$PROG" ] || return 1
    config_load singbox 2>/dev/null || true
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0
    [ -f "$CONFIG" ] || return 1

    recover_pending_config || return 1
    "$PROG" check -c "$CONFIG" >/dev/null 2>&1 || return 1
    [ ! -x "$FIREWALL" ] || "$FIREWALL" apply || return 1

    procd_open_instance
    procd_set_param command "$PROG" run -c "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG"
    procd_close_instance
}

stop_service() {
    [ ! -x "$FIREWALL" ] || "$FIREWALL" cleanup
}

service_triggers() {
    procd_add_reload_trigger singbox
}
