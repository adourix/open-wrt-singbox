#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

NAME=cowboy-bebop
PROG=/usr/bin/sing-box
INIT=/etc/init.d/cowboy-bebop
CONFIG=/etc/cowboy-bebop/config.json
CANDIDATE=/etc/cowboy-bebop/config.json.new
BACKUP=/etc/cowboy-bebop/config.json.bak
PENDING=/etc/cowboy-bebop/config.pending
PENDING_STATE=/etc/cowboy-bebop/state.pending.json
FIREWALL=/usr/lib/cowboy-bebop/network/firewall.sh

log_error() {
    logger -t cowboy-bebop "$1"
}

recover_pending_config() {
    [ -f "$PENDING" ] || [ -f "$PENDING_STATE" ] || return 0

    if [ -f "$BACKUP" ] && "$PROG" check -c "$BACKUP" >/dev/null 2>&1; then
        cp -f "$BACKUP" "$CONFIG" || { log_error 'failed to restore pending configuration backup'; return 1; }
        chmod 600 "$CONFIG" 2>/dev/null || true
        if [ -f "$PENDING_STATE" ]; then
            old_proxy_url=$(jq -er '.proxy_url | strings' "$PENDING_STATE") || return 1
            old_allow_insecure=$(jq -er '.allow_insecure | strings' "$PENDING_STATE") || return 1
            old_auto_start=$(jq -er '.auto_start | strings' "$PENDING_STATE") || return 1
            old_enabled=$(jq -er '.enabled | strings' "$PENDING_STATE") || return 1
            uci set cowboy-bebop.main.proxy_url="$old_proxy_url" || return 1
            uci set cowboy-bebop.main.allow_insecure="$old_allow_insecure" || return 1
            uci set cowboy-bebop.main.auto_start="$old_auto_start" || return 1
            uci set cowboy-bebop.main.enabled="$old_enabled" || return 1
            uci commit cowboy-bebop || return 1
            chmod 600 /etc/config/cowboy-bebop 2>/dev/null || true
            case "$old_auto_start" in
                1|yes|true) "$INIT" enable || return 1 ;;
                *) "$INIT" disable || return 1 ;;
            esac
        else
            uci set cowboy-bebop.main.enabled=0 || return 1
            uci set cowboy-bebop.main.auto_start=0 || return 1
            uci commit cowboy-bebop || return 1
            chmod 600 /etc/config/cowboy-bebop 2>/dev/null || true
            "$INIT" disable || return 1
        fi
        rm -f "$PENDING" "$PENDING_STATE"
        log_error 'pending configuration rolled back during boot'
        return 0
    fi

    log_error 'pending configuration has no valid backup; disabling Cowboy Bebop safely'
    rm -f "$CONFIG" "$CANDIDATE"
    uci set cowboy-bebop.main.enabled=0 || return 1
    uci set cowboy-bebop.main.auto_start=0 || return 1
    uci commit cowboy-bebop || return 1
    chmod 600 /etc/config/cowboy-bebop 2>/dev/null || true
    "$INIT" disable || return 1
    rm -f "$PENDING" "$PENDING_STATE"
    return 0
}

# Pending confirmation is a boot-recovery concern, not a normal start/restart concern.
# manager.sh deliberately restarts the service while a new configuration is pending.
boot() {
    recover_pending_config || return 1
    start "$@"
}

start_service() {
    [ -x "$PROG" ] || { log_error 'sing-box binary is missing'; return 1; }
    config_load cowboy-bebop 2>/dev/null || true
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0
    [ -f "$CONFIG" ] || { log_error 'sing-box configuration is missing'; return 1; }
    if ! "$PROG" check -c "$CONFIG" >/dev/null 2>&1; then
        log_error 'sing-box configuration check failed'
        return 1
    fi
    if [ -x "$FIREWALL" ] && ! "$FIREWALL" apply >/dev/null 2>&1; then
        log_error 'Cowboy Bebop firewall setup failed'
        "$FIREWALL" cleanup >/dev/null 2>&1 || true
        return 1
    fi
    procd_open_instance
    procd_set_param command "$PROG" run -c "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG"
    procd_close_instance
}

stop_service() {
    if [ -x "$FIREWALL" ]; then
        "$FIREWALL" cleanup >/dev/null 2>&1 || log_error 'firewall cleanup failed'
    fi
}

service_triggers() {
    procd_add_reload_trigger cowboy-bebop
}
