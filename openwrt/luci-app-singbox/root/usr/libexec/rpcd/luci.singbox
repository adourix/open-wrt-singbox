#!/bin/sh
# rpcd executable plugin for luci.singbox.
# Never returns the stored proxy URL, UUID, or private credentials.

MANAGER=/usr/bin/singbox-manager
CONFIG=/etc/singbox/config.json

json_error() {
    jq -cn --arg error "$1" '{ok:false,error:$error}'
}

short_error() {
    printf '%s\n' "$1" | tail -n 1 | cut -c 1-240
}

status_json() {
    running=false; valid=false; tun=false; routing=false; enabled=false; pending=false; auto_start=false; allow_insecure=false
    configured=false; protocol=; server=; server_port=; transport=; tls=false; state=STOPPED

    [ "$(uci -q get singbox.main.enabled 2>/dev/null)" = "1" ] && enabled=true
    [ -n "$(uci -q get singbox.main.proxy_url 2>/dev/null)" ] && configured=true
    [ "$(uci -q get singbox.main.allow_insecure 2>/dev/null)" = "1" ] && allow_insecure=true
    [ -f /etc/singbox/config.pending ] || [ -f /etc/singbox/state.pending.json ] && pending=true
    /etc/init.d/singbox enabled >/dev/null 2>&1 && auto_start=true

    if command -v sing-box >/dev/null 2>&1 && [ -f "$CONFIG" ] && sing-box check -c "$CONFIG" >/dev/null 2>&1; then
        valid=true
    fi
    if command -v pidof >/dev/null 2>&1 && pidof sing-box >/dev/null 2>&1; then
        running=true
        state=RUNNING
        ip link show tun0 >/dev/null 2>&1 && tun=true
        ip route show table all 2>/dev/null | grep -q '[[:space:]]dev tun0\([[:space:]]\|$\)' && routing=true
    elif [ "$enabled" = true ]; then
        state=ERROR
    fi

    if [ -f "$CONFIG" ]; then
        protocol=$(jq -r '(.outbounds // [])[] | select(.tag == "proxy-out") | .type // empty' "$CONFIG" 2>/dev/null | head -n 1)
        server=$(jq -r '(.outbounds // [])[] | select(.tag == "proxy-out") | .server // empty' "$CONFIG" 2>/dev/null | head -n 1)
        server_port=$(jq -r '(.outbounds // [])[] | select(.tag == "proxy-out") | .server_port // empty' "$CONFIG" 2>/dev/null | head -n 1)
        transport=$(jq -r '(.outbounds // [])[] | select(.tag == "proxy-out") | .transport.type // "tcp"' "$CONFIG" 2>/dev/null | head -n 1)
        tls=$(jq -r '(.outbounds // [])[] | select(.tag == "proxy-out") | (.tls.enabled // false)' "$CONFIG" 2>/dev/null | head -n 1)
    fi

    jq -cn \
        --argjson enabled "$enabled" \
        --argjson running "$running" \
        --argjson valid "$valid" \
        --argjson tun "$tun" \
        --argjson routing "$routing" \
        --argjson auto_start "$auto_start" \
        --argjson pending "$pending" \
        --argjson configured "$configured" \
        --argjson allow_insecure "$allow_insecure" \
        --arg state "$state" \
        --arg protocol "${protocol:-}" \
        --arg server "${server:-}" \
        --arg server_port "${server_port:-}" \
        --arg transport "${transport:-}" \
        --argjson tls "${tls:-false}" \
        '{state:$state,enabled:$enabled,running:$running,auto_start:$auto_start,allow_insecure:$allow_insecure,configuration_valid:$valid,tun:$tun,routing:$routing,pending:$pending,configured:$configured,protocol:$protocol,server:$server,server_port:$server_port,transport:$transport,tls:$tls}'
}

preview_profile() {
    proxy_url=$1
    allow_insecure=$2
    [ -n "$proxy_url" ] || return 1
    . /usr/lib/singbox-manager/protocol/detector.sh || return 1
    . /usr/lib/singbox-manager/protocol/vmess/parser.sh || return 1
    . /usr/lib/singbox-manager/protocol/vless/parser.sh || return 1
    protocol=$(detect_protocol "$proxy_url") || return 1
    case "$protocol" in
        vmess) profile=$(vmess_parse "$proxy_url") || return 1 ;;
        vless) profile=$(VLESS_ALLOW_INSECURE="$allow_insecure" vless_parse "$proxy_url") || return 1 ;;
        *) return 1 ;;
    esac
    printf '%s' "$profile" | jq -c '{protocol,server,server_port,transport:.transport.type,tls:.tls.enabled,name:(.metadata.name // null)}'
}

run_manager() {
    output=$($MANAGER "$1" 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        printf '%s\n' '{"ok":true}'
    else
        json_error "$(short_error "$output")"
    fi
    return 0
}

case "$1" in
list)
    printf '%s\n' '{"status":{},"preview":{"proxy_url":"","allow_insecure":false},"apply":{"proxy_url":"","auto_start":true,"allow_insecure":false},"start":{},"stop":{},"set_enabled":{"enabled":true},"health":{},"logs":{},"confirm":{}}'
    ;;
call)
    case "$2" in
    status)
        status_json
        ;;
    health)
        "$MANAGER" health >/dev/null 2>&1; rc=$?
        status_json | jq --argjson ok "$([ "$rc" -eq 0 ] && echo true || echo false)" '. + {ok:$ok}'
        [ "$rc" -eq 0 ] || exit 1
        ;;
    preview)
        input=$(cat)
        proxy_url=$(printf '%s' "$input" | jq -er '.proxy_url | strings') || exit 1
        allow_insecure=$(printf '%s' "$input" | jq -er 'if has("allow_insecure") then (.allow_insecure | if type=="boolean" then . else error end) else false end') || exit 1
        if ! output=$(preview_profile "$proxy_url" "$([ "$allow_insecure" = true ] && echo 1 || echo 0)" 2>&1); then
            json_error "$(short_error "$output")"
            exit 0
        fi
        printf '%s\n' "$output"
        ;;
    apply)
        input=$(cat)
        proxy_url=$(printf '%s' "$input" | jq -er '.proxy_url | strings') || { json_error 'Proxy URL is required.'; exit 0; }
        [ -n "$proxy_url" ] || { json_error 'Proxy URL is required.'; exit 0; }
        auto_start=$(printf '%s' "$input" | jq -er 'if has("auto_start") then (.auto_start|if type=="boolean" then . else error end) else true end') || { json_error 'Invalid Auto Start value.'; exit 0; }
        allow_insecure=$(printf '%s' "$input" | jq -er 'if has("allow_insecure") then (.allow_insecure|if type=="boolean" then . else error end) else false end') || { json_error 'Invalid insecure TLS setting.'; exit 0; }
        allow_value=$([ "$allow_insecure" = true ] && echo 1 || echo 0)
        auto_value=$([ "$auto_start" = true ] && echo 1 || echo 0)
        if output=$(SINGBOX_PROXY_URL="$proxy_url" SINGBOX_AUTO_START="$auto_value" SINGBOX_ALLOW_INSECURE="$allow_value" "$MANAGER" apply 2>&1); then
            printf '%s\n' '{"ok":true,"applied":true}'
        else
            json_error "$(short_error "$output")"
        fi
        ;;
    start)
        run_manager start
        ;;
    stop)
        run_manager stop
        ;;
    set_enabled)
        enabled=$(cat | jq -er '.enabled | if type=="boolean" then . else error end') || { json_error 'Invalid ON/OFF value.'; exit 0; }
        if [ "$enabled" = true ]; then
            run_manager start
        else
            run_manager stop
        fi
        ;;
    confirm)
        if output=$($MANAGER confirm 2>&1); then
            printf '%s\n' '{"ok":true,"confirmed":true}'
        else
            json_error "$(short_error "$output")"
        fi
        ;;
    logs)
        logread -e singbox 2>/dev/null | tail -n 30 |
            sed -E 's#(vless|vmess)://[^[:space:]]+#[REDACTED-URL]#g; s/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}/[REDACTED-UUID]/g' |
            jq -Rsc '{lines:(split("\n")|map(select(length>0)))}'
        ;;
    *) exit 1 ;;
    esac
    ;;
esac
