{
  "luci-app-singbox": {
    "description": "Allow LuCI to manage singbox without exposing proxy credentials",
    "read": {
      "ubus": {
        "luci.singbox": ["status", "health", "logs", "preview", "confirm"]
      }
    },
    "write": {
      "ubus": {
        "luci.singbox": ["apply", "start", "stop", "set_enabled", "confirm"]
      }
    }
  }
}
